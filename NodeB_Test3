int __io_putchar(int ch)
{
    HAL_UART_Transmit(&huart2, (uint8_t *)&ch, 1, HAL_MAX_DELAY);
    return ch;
}

// Returns +1 on a confirmed press, -1 on a confirmed release, 0 otherwise
static int8_t Button_Update(Button_t *b)
{
    uint8_t raw = (HAL_GPIO_ReadPin(b->port, b->pin) == GPIO_PIN_RESET);
    uint32_t now = HAL_GetTick();

    if (raw != b->last_raw) {
        b->last_raw = raw;
        b->last_change = now;
    }
    if ((now - b->last_change) >= DEBOUNCE_MS && raw != b->stable) {
        b->stable = raw;
        return raw ? 1 : -1;
    }
    return 0;
}

static uint8_t Ignition_On(void)
{
#if IGNITION_TEST_OVERRIDE
    return 1;
#else
    return bcm_alive && bcm_ignition;   // no BCM link means no window
#endif
}

static void Print_Status(void)
{
    printf("[STATUS] BCM=%s Ign=%s Door=%s Lock=%s Window=%u%%\r\n",
           bcm_alive ? "OK" : "LOST",
           Ignition_On() ? "ON" : "OFF",
           door_open ? "OPEN" : "CLOSED",
           lock_state ? "LOCKED" : "UNLOCKED",
           window_pct);
}

static void Window_Apply(void)
{
    uint32_t us = WINDOW_MIN_US + (uint32_t)window_pct * (WINDOW_MAX_US - WINDOW_MIN_US) / 100;
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_1, us);
}

static void Lock_Apply(void)
{
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_2, lock_state ? LOCKED_US : UNLOCKED_US);
}

static void Set_Lock(uint8_t want)
{
    if (want && door_open) {
        printf("Lock refused: door is open\r\n");
        return;
    }
    if (lock_state == want) return;
    lock_state = want;
    Lock_Apply();
    printf("Lock: %s\r\n", lock_state ? "LOCKED" : "UNLOCKED");
    Print_Status();
}

static void MCP_Reset(void)
{
    uint8_t cmd = 0xC0;
    MCP_Select();
    HAL_SPI_Transmit(&hspi2, &cmd, 1, 10);
    MCP_Deselect();
    HAL_Delay(10);
}

static uint8_t MCP_ReadReg(uint8_t reg)
{
    uint8_t cmd[2] = { 0x03, reg };
    uint8_t val = 0;
    MCP_Select();
    HAL_SPI_Transmit(&hspi2, cmd, 2, 10);
    HAL_SPI_Receive(&hspi2, &val, 1, 10);
    MCP_Deselect();
    return val;
}

static void MCP_WriteReg(uint8_t reg, uint8_t val)
{
    uint8_t tx[3] = { 0x02, reg, val };
    MCP_Select();
    HAL_SPI_Transmit(&hspi2, tx, 3, 10);
    MCP_Deselect();
}

// 500 kbit/s with an 8 MHz module crystal. Returns 1 on success.
static uint8_t MCP_Init(uint8_t mode)
{
    MCP_Reset();
    if ((MCP_ReadReg(0x0E) & 0xE0) != 0x80) return 0;   // must be in config mode

    MCP_WriteReg(0x2A, 0x00);   // CNF1
    MCP_WriteReg(0x29, 0x90);   // CNF2
    MCP_WriteReg(0x28, 0x02);   // CNF3
    MCP_WriteReg(0x60, 0x60);   // RXB0CTRL: filters off, accept all
    MCP_WriteReg(0x2B, 0x01);   // CANINTE: INT low when a frame arrives
    MCP_WriteReg(0x0F, mode);   // request the mode
    HAL_Delay(5);

    return ((MCP_ReadReg(0x0E) & 0xE0) == (mode & 0xE0));
}

static uint8_t MCP_Send(uint16_t id, const uint8_t *data, uint8_t len)
{
    if (MCP_ReadReg(0x30) & 0x08) return 0;   // TXB0 still pending

    uint8_t buf[15];
    buf[0] = 0x02;                       // WRITE
    buf[1] = 0x31;                       // TXB0SIDH
    buf[2] = (uint8_t)(id >> 3);
    buf[3] = (uint8_t)((id & 0x07) << 5);
    buf[4] = 0;
    buf[5] = 0;
    buf[6] = len;
    for (uint8_t i = 0; i < len; i++) buf[7 + i] = data[i];

    MCP_Select();
    HAL_SPI_Transmit(&hspi2, buf, 7 + len, 10);
    MCP_Deselect();

    uint8_t rts = 0x81;                  // request to send, buffer 0
    MCP_Select();
    HAL_SPI_Transmit(&hspi2, &rts, 1, 10);
    MCP_Deselect();
    return 1;
}

static void MCP_Receive(uint16_t *id, uint8_t *dlc, uint8_t *data)
{
    uint8_t cmd = 0x90;                  // READ RX BUFFER 0 (clears RX0IF)
    uint8_t rx[14] = { 0 };

    MCP_Select();
    HAL_SPI_Transmit(&hspi2, &cmd, 1, 10);
    HAL_SPI_Receive(&hspi2, rx, 14, 10);
    MCP_Deselect();

    *id  = ((uint16_t)rx[0] << 3) | (rx[1] >> 5);
    *dlc = rx[4] & 0x0F;
    for (uint8_t i = 0; i < 8; i++) data[i] = rx[5 + i];
}

static void Can_SendDoorStatus(void)
{
    uint8_t d[4] = { door_open, lock_state, window_pct, tx_counter++ };
    if (MCP_Send(CAN_ID_DOOR_STATUS, d, 4)) {
        if (!bus_ok) { bus_ok = 1; printf("[CAN] TX OK\r\n"); }
    } else if (bus_ok) {
        bus_ok = 0;
        printf("[CAN] TX not acknowledged - check bus and Node A\r\n");
    }
}
