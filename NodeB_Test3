/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI2_Init();
  MX_TIM3_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
  printf("\r\n==== Node B (Door Module) started ====\r\n");
  Print_Status();

  HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_1);
  HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_2);
  Window_Apply();
  Lock_Apply();

  if (MCP_Init(MCP_MODE))
      printf("[INIT] MCP2515 OK (%s)\r\n", LOOPBACK_TEST ? "loopback" : "normal");
  else
      printf("[INIT] MCP2515 FAILED, CANSTAT=0x%02X\r\n", MCP_ReadReg(0x0E));
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  int8_t e;
	  uint32_t now = HAL_GetTick();
	     /* Door switch: open while held */
	     e = Button_Update(&btn_door);
	     if (e) {
	         door_open = btn_door.stable;
	         printf("Door: %s\r\n", door_open ? "OPEN" : "CLOSED");
	         Print_Status();
	     }

	     /* Lock button: toggle */
	     e = Button_Update(&btn_lock);
	     if (e == 1) {
	         printf("Lock button pressed\r\n");
	         Set_Lock(!lock_state);
	     }

	     /* Window UP */
	     e = Button_Update(&btn_win_up);
	     if (e == 1) {
	         if (!Ignition_On()) {
	             printf("Window UP ignored: ignition OFF\r\n");
	         } else {
	             window_pct = (window_pct + WINDOW_STEP > 100) ? 100 : window_pct + WINDOW_STEP;
	             Window_Apply();
	             printf("Window UP -> %u%%\r\n", window_pct);
	         }
	     }

	     /* Window DOWN */
	     e = Button_Update(&btn_win_down);
	     if (e == 1) {
	         if (!Ignition_On()) {
	             printf("Window DOWN ignored: ignition OFF\r\n");
	         } else {
	             window_pct = (window_pct < WINDOW_STEP) ? 0 : window_pct - WINDOW_STEP;
	             Window_Apply();
	             printf("Window DOWN -> %u%%\r\n", window_pct);
	         }
	     }

	     /* Send Door_Status (0x200) every 100 ms */
	     if ((now - last_tx_tick) >= TX_PERIOD_MS) {
	         last_tx_tick = now;
	         Can_SendDoorStatus();
	     }

	     /* Print received frames (about once per second, to keep the terminal readable) */
#if LOOPBACK_TEST
    /* Fake Node A: BCM_Cmd every 100 ms for 6 s, then silent for 2 s */
    if ((now - last_fake_tick) >= 100) {
        last_fake_tick = now;
        if ((now % 8000) < 6000) {
            if (!door_open) fake_lock = 1;          // latches like Node A's auto-lock
            uint8_t f[3] = { 1, fake_lock, fake_cnt++ };
            MCP_Send(CAN_ID_BCM_CMD, f, 3);
        }
    }
#endif

    /* Receive frames */
    if (HAL_GPIO_ReadPin(MCP_INT_GPIO_Port, MCP_INT_Pin) == GPIO_PIN_RESET) {
        uint16_t rid; uint8_t rdlc; uint8_t rd[8];
        MCP_Receive(&rid, &rdlc, rd);

        if (rid == CAN_ID_BCM_CMD && rdlc >= 3) {
            last_bcm_rx = now;

            if (!bcm_alive) {
                bcm_alive = 1;
                printf("[CAN] BCM link OK\r\n");
            }
            if (rd[0] != bcm_ignition) {
                bcm_ignition = rd[0];
                printf("[BCM] Ignition=%s\r\n", bcm_ignition ? "ON" : "OFF");
                Print_Status();
            }
            if (rd[1] != bcm_lock_cmd) {            // act only when the command CHANGES
                bcm_lock_cmd = rd[1];
                printf("[BCM] Lock command=%s\r\n", bcm_lock_cmd == CMD_LOCK ? "LOCK" : "UNLOCK");
                Set_Lock(bcm_lock_cmd == CMD_LOCK);
            }
        }
    }

    /* BCM timeout: fail-safe (window disabled, lock holds its last position) */
    if (bcm_alive && ((now - last_bcm_rx) > BCM_TIMEOUT_MS)) {
        bcm_alive = 0;
        bcm_ignition = 0;
        printf("[WARN] BCM lost - fail-safe: window disabled, lock holds\r\n");
        Print_Status();
    }

    /* LD2: solid = BCM link OK, fast blink = BCM lost */
    if (bcm_alive) {
        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
    } else if ((now - last_led_tick) >= 100) {
        last_led_tick = now;
        HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
    }
  }
  /* USER CODE END 3 */
}

