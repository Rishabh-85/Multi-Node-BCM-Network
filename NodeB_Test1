/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI2_Init();
  MX_TIM3_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
  printf("\r\n==== Node B (Door) started ====\r\n");
  if (MCP_Init(MCP_MODE))
      printf("[INIT] MCP2515 OK (%s)\r\n", LOOPBACK_TEST ? "loopback" : "normal");
  else
      printf("[INIT] MCP2515 FAILED, CANSTAT=0x%02X\r\n", MCP_ReadReg(0x0E));
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	    uint32_t now = HAL_GetTick();
	    int8_t e;

	    /* 1. Inputs */
	    e = Button_Update(&btn_door);
	    door_open = btn_door.stable;
	    if (e) {
	        printf("Door: %s\r\n", door_open ? "OPEN" : "CLOSED");
	        Print_Status();
	    }

	    e = Button_Update(&btn_lock);
	    if (e == 1) {
	        printf("Lock button pressed\r\n");
	#if LOOPBACK_TEST
	        test_ignition = !test_ignition;      // TEST ONLY: fake ignition from Node A
	        printf("Test: simulated ignition = %s\r\n", test_ignition ? "ON" : "OFF");
	#endif
	    }

	    e = Button_Update(&btn_win_up);
	    if (e == 1)  printf("Window UP pressed\r\n");
	    if (e == -1) printf("Window UP released\r\n");

	    e = Button_Update(&btn_win_down);
	    if (e == 1)  printf("Window DOWN pressed\r\n");
	    if (e == -1) printf("Window DOWN released\r\n");

	#if LOOPBACK_TEST
	    /* 2. TEST ONLY: act as Node A. Hold Window DOWN to pause it (simulates Node A going silent). */
	    if (!btn_win_down.stable && (now - last_test_tx) >= TEST_TX_PERIOD_MS) {
	        last_test_tx = now;
	        uint8_t d[3] = { test_ignition, test_ignition, test_counter++ };
	        MCP_Send(CAN_ID_BCM_CMD, d, 3);
	    }
	#endif

	    /* 3. Receive BCM_Cmd (0x100) when INT goes low */
	    if (HAL_GPIO_ReadPin(MCP_INT_GPIO_Port, MCP_INT_Pin) == GPIO_PIN_RESET) {
	        uint16_t rid; uint8_t rdlc; uint8_t rd[8];
	        MCP_Receive(&rid, &rdlc, rd);
	        if (rid == CAN_ID_BCM_CMD && rdlc >= 3) {
	            last_bcm_rx = now;
	            uint8_t changed = (rd[0] != bcm_ignition || rd[1] != bcm_lock_cmd);
	            if (!bcm_alive) {
	                bcm_alive = 1;
	                printf("BCM link OK\r\n");
	                changed = 1;
	            }
	            bcm_ignition = rd[0];
	            bcm_lock_cmd = rd[1];
	            if (changed) {
	                printf("[BCM] Ign=%u LockCmd=%u\r\n", bcm_ignition, bcm_lock_cmd);
	                Print_Status();
	            }
	        }
	    }

	    /* 4. BCM timeout (500 ms): fail-safe */
	    if (bcm_alive && ((now - last_bcm_rx) > BCM_TIMEOUT_MS)) {
	        bcm_alive = 0;
	        bcm_ignition = 0;
	        bcm_lock_cmd = 0;
	        printf("WARNING: BCM lost - fail-safe\r\n");
	        Print_Status();
	    }

	    /* 5. LD2 Automotive Heartbeat Indicator */
	        if (bcm_alive) {
	            // Link healthy: LED stays solid ON
	            HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
	        } else if ((now - last_led_tick) >= 100) {
	            // Fail-safe / Link LOST: rapid 100 ms blink
	            last_led_tick = now;
	            HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
	        }

  }
  /* USER CODE END 3 */
}

